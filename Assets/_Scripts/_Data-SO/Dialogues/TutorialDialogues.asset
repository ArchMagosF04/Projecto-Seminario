  dialogueLines:
  - speakerName: Lejandaro
    speakerTextBoxSprite: {fileID: -1728115917479248544, guid: 6f8a009d17092204c8a2a092e972d6b2, type: 3}
    dialogueLines: "Ha! People couldn\u2019t care less about what\u2019s going on
      around them. They let a real-life human into a hologram competition. Unbelievable!\r"
    displaySide: 0
    typingSpeed: 0
    voiceSound:
      ID: 1073741841
      _sourceAsset: {fileID: 11400000, guid: 5802d47db847d6b4d991b27d079f0e00, type: 2}
      <DebugObject>k__BackingField: {fileID: 0}
    autoProgressDialogue: 0
    autoProgressDelay: 0
  - speakerName: Lejandaro
    speakerTextBoxSprite: {fileID: -1728115917479248544, guid: 6f8a009d17092204c8a2a092e972d6b2, type: 3}
    dialogueLines: "Anyway, I\u2019m gonna show them that the only real, good music
      can be made by people, not by some... machine? Whatever. I\u2019m gonna be
      the best, I\u2019m gonna crush them all!.\r"
    displaySide: 0
