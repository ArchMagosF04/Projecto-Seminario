    autoProgressDelay: 0
  - speakerName: Smilui
    speakerTextBoxSprite: {fileID: -2167837597418890444, guid: 244a8e9d485d8e2439ce2d8a666434eb, type: 3}
    dialogueLines: "Get away from me, we've got nothing more to talk about. I lost
      to someone else, but now, I\u2019m going to win this."
    displaySide: 1
    typingSpeed: 0
    voiceSound:
      ID: 1073741844
