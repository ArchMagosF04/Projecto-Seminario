    autoProgressDelay: 0
  - speakerName: Delgar
    speakerTextBoxSprite: {fileID: -7398361656275568863, guid: 08d64f4697f3e2043af8ef45dbf81072, type: 3}
    dialogueLines: "Illusion? Don\u2019t forget, sister. You know, you shouldn\u2019t
      play around. A shadow you will soon be."
    displaySide: 1
    typingSpeed: 0
    voiceSound:
      ID: 1073741842
