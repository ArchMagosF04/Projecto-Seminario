  dialogueLines:
  - speakerName: Lejandaro
    speakerTextBoxSprite: {fileID: -1728115917479248544, guid: 6f8a009d17092204c8a2a092e972d6b2, type: 3}
    dialogueLines: "And now what? An Anitta simulation? Looks like we did a full
      180. How interesting. Go on then, show me what you\u2019ve got."
    displaySide: 0
    typingSpeed: 0
    voiceSound:
      ID: 1073741841
      _sourceAsset: {fileID: 11400000, guid: 5802d47db847d6b4d991b27d079f0e00, type: 2}
      <DebugObject>k__BackingField: {fileID: 0}
    autoProgressDialogue: 0
    autoProgressDelay: 0
  - speakerName: Ttani
    speakerTextBoxSprite: {fileID: 1803404758278819127, guid: d40d6c51b0d2b4947ae51312b5284f0f, type: 3}
    dialogueLines: "Everybody wants to get close to me, but I don't want anyone.
      Dare to come closer, and I\u2019ll beat you in a blink of an eye."
    displaySide: 1
    typingSpeed: 0
    voiceSound:
      ID: 1073741843
