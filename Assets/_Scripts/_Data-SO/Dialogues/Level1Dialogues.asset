  dialogueLines:
  - speakerName: Lejandaro
    speakerTextBoxSprite: {fileID: -1728115917479248544, guid: 6f8a009d17092204c8a2a092e972d6b2, type: 3}
    dialogueLines: "My, my, look what we have here. One of the biggest names in Tango.
      Don\u2019t you dare think I didn\u2019t come prepared, illusion. Let\u2019s
      dance!."
    displaySide: 0
    typingSpeed: 0
    voiceSound:
      ID: 1073741841
      _sourceAsset: {fileID: 11400000, guid: 5802d47db847d6b4d991b27d079f0e00, type: 2}
